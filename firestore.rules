rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ★ app.js 의 ADMIN_EMAILS 와 똑같이 맞춰 주세요
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['gydnjshw@naver.com'];
    }

    // 회원: 누구나 보기, 관리자만 수정
    match /members/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 행사(날짜별 페이지, 참가자 명단, 종목·리그 결과): 누구나 보기, 관리자만 수정
    match /events/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 회비 (연도별 문서): 누구나 보기, 관리자만 수정
    match /fees/{year} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 모임 사진: 누구나 보기, 관리자만 올리기·삭제 (크기 제한)
    match /photos/{id} {
      allow read: if true;
      allow create: if isAdmin() && request.resource.data.thumb is string && request.resource.data.thumb.size() < 300000;
      allow delete: if isAdmin();
    }
    match /photoFull/{id} {
      allow read: if true;
      allow create: if isAdmin() && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
      allow delete: if isAdmin();
    }

    // 경기 기록
    match /matches/{id} {
      allow read: if true;

      // 관리자: 무엇이든 입력 (리그 단식 포함)
      // 로그인 안 한 회원: '자유 경기'만 입력 가능 (그날 참가자끼리, 형식 검사)
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['eventId','date','year','winnerId','loserId','score','createdAt'])
        && request.resource.data.winnerId is string
        && request.resource.data.loserId is string
        && request.resource.data.winnerId != request.resource.data.loserId
        && request.resource.data.score is string
        && request.resource.data.score.size() <= 10
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/events/$(request.resource.data.eventId))
        && request.resource.data.winnerId in get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.attendees
        && request.resource.data.loserId in get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.attendees
        && request.resource.data.date == get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.date
        && request.resource.data.year == get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.year
      );

      allow update: if isAdmin();

      // 관리자는 언제나 삭제, 자유 경기는 입력 후 5분 안에 취소 가능
      allow delete: if isAdmin() || (
        !('note' in resource.data)
        && request.time < resource.data.createdAt + duration.value(5, 'm')
      );
    }
  }
}
